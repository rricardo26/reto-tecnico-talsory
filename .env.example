# Configuración de puertos de la máquina anfitriona (Laptop)
# Modifica estos valores si los puertos por defecto están ocupados
WEB_PORT=8080
API_ENDOSOS_PORT=3000
API_RUTAS_PORT=8081
DB_PORT=5432

# Credenciales de Base de Datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interseguro_endosos

# Seguridad JWT (compartido entre microservicios)
JWT_SECRET=interseguro-super-secret-key
JWT_EXPIRATION=3600
